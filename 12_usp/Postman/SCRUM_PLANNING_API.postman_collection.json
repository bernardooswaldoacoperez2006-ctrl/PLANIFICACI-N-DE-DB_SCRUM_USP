{
  "info": {
    "name": "SCRUM_PLANNING API",
    "description": "Autenticación JWT y listado de usuarios protegidos por rol administrador.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userName\": \"CALHECTOR\",\n  \"userPassword\": \"12345678\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/websocket/users/authenticate",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "websocket",
            "users",
            "authenticate"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.collectionVariables.set('token', data.access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar usuarios (solo administrador)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/websocket/users/list?page=1&rows_per_page=100",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "websocket",
            "users",
            "list"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "rows_per_page",
              "value": "100"
            }
          ]
        }
      }
    }
  ]
}